# Must match the coturn container's --static-auth-secret (see
# docker-compose.yml at the repo root).
TURN_SECRET=local-dev-turn-secret-change-in-production
TURN_URLS=turn:127.0.0.1:3478
TURN_CREDENTIAL_TTL=3600

IP_HASH_SALT=local-dev-ip-salt-change-in-production
REPORT_BAN_THRESHOLD=3
REPORT_WINDOW_SECONDS=86400
REPORT_BAN_DURATION_SECONDS=86400
